# Neon Postgres connection string. Pooled URL for runtime, direct for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/bestiario?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/bestiario?sslmode=require"

# WorkOS AuthKit (Google OAuth) — https://dashboard.workos.com
WORKOS_API_KEY="sk_example_xxx"
WORKOS_CLIENT_ID="client_xxx"
# Must exactly match a redirect URI configured in the WorkOS dashboard.
WORKOS_REDIRECT_URI="http://localhost:5173/admin/callback"
# 32+ char secret used to seal/unseal the admin session cookie. Generate with:
# openssl rand -base64 32
WORKOS_COOKIE_PASSWORD="change-me-to-a-random-32-plus-char-secret"
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS="you@example.com"
