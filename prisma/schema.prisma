generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleKind {
  PERSONA
  ORGANIZACION
  VICTIMA
}

model Article {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  kind            ArticleKind @default(PERSONA)
  summary         String?
  contentHtml     String      @db.Text
  infoboxJson     Json?
  published       Boolean     @default(true)
  pictureData     Bytes?
  pictureMimeType String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  categories ArticleCategory[]
  revisions  Revision[]

  relationsFrom ArticleRelation[] @relation("RelationFrom")
  relationsTo   ArticleRelation[] @relation("RelationTo")

  @@index([title])
  @@index([kind])
}

/// A directed link between two entries, e.g. A "responsable de" B.
model ArticleRelation {
  id     String @id @default(cuid())
  fromId String
  toId   String
  label  String

  from Article @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Article @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, label])
  @@index([toId])
}

model Revision {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  contentHtml String   @db.Text
  summary     String?
  authorName  String?
  createdAt   DateTime @default(now())

  @@index([articleId, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  articles ArticleCategory[]
}

model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model Tweet {
  id           String       @id
  authorName   String
  authorHandle String
  text         String       @db.Text
  sourceUrl    String
  videoUrl     String?
  fetchedAt    DateTime     @default(now())
  media        TweetMedia[]
}

model TweetMedia {
  id       String @id @default(cuid())
  tweetId  String
  tweet    Tweet  @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  kind     String
  mimeType String
  data     Bytes
  order    Int

  @@index([tweetId])
}

model Bookmark {
  url             String   @id
  title           String?
  description     String?
  imageData       Bytes?
  imageMimeType   String?
  faviconData     Bytes?
  faviconMimeType String?
  fetchedAt       DateTime @default(now())
}
